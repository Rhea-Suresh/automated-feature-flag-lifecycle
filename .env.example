# ==========================================
# Automated Feature Flag Lifecycle Configuration
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==========================================

# --- PostgreSQL Configuration ---
DATABASE_NAME=unleash
DATABASE_USERNAME=unleash_user
DATABASE_PASSWORD=unleash_secure_password_replace_me

# --- Unleash Server Configuration ---
UNLEASH_HOST_PORT=4242
UNLEASH_DEFAULT_ADMIN_USERNAME=admin
UNLEASH_DEFAULT_ADMIN_PASSWORD=unleash4all

# --- Application Service Configuration ---
APP_PORT=3000
NODE_ENV=production
UNLEASH_API_URL=http://unleash:4242/api
UNLEASH_APP_NAME=feature-flag-app

# --- Unleash Client API Token ---
# Generate this in the Unleash UI (Project Settings -> API Access -> Create token -> Client token)
# Format: default:development.<hash>
UNLEASH_API_TOKEN=default:development.replace_with_client_sdk_token
